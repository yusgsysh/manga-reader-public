# Settings page overrides / 运行时设置
# 这里的变量是「初始值」。Cookie、图片缓存存储、LOG_LEVEL、MANGA_READER_DEV_TOOLS
# 还可以在前端「设置」页修改，改动会存入数据库并立即生效（无需重启）；
# 数据库中的值优先于本文件。未被设置页改动的键仍读取这里的值。
#
# These variables are the starting point. Cookie, image-cache storage, LOG_LEVEL
# and MANGA_READER_DEV_TOOLS can also be edited on the settings page, which
# stores them in the database and applies them immediately (no restart).
# Saved values win; keys you never touch there keep reading this file.

# ExHentai Cookies / ExHentai Cookie（设置页填写即可，环境变量只是引导值）
# Method 1: full cookie string
# EHENTAI_COOKIE=ipb_member_id=xxx; ipb_pass_hash=xxx
# Method 2: individual env vars
EHENTAI_COOKIE_IPB_MEMBER_ID=
EHENTAI_COOKIE_IPB_PASS_HASH=
EHENTAI_COOKIE_IGNEOUS=
EHENTAI_COOKIE_SK=

# Server port (default: 8080)
EHENTAI_PORT=8080

# Database / 数据库
# 驱动：sqlite（默认）或 postgres（别名 postgresql / pg）
# Driver: sqlite (default) or postgres (aliases: postgresql / pg)
MANGA_READER_DB_DRIVER=sqlite

# SQLite 路径（默认 data/manga-reader.db；Docker 内 /app/data/manga-reader.db）
# SQLite path (default: data/manga-reader.db; in Docker: /app/data/manga-reader.db)
# MANGA_READER_DB_PATH=

# PostgreSQL 连接串（MANGA_READER_DB_DRIVER=postgres 时必填）
# PostgreSQL connection string (required when MANGA_READER_DB_DRIVER=postgres)
# 未设置 MANGA_READER_DB_DSN 时回退读取 DATABASE_URL。
# Falls back to DATABASE_URL when MANGA_READER_DB_DSN is unset.
# MANGA_READER_DB_DSN=postgres://user:pass@localhost:5432/manga_reader?sslmode=disable

# Frontend (Angie) reverse-proxy backend address
# 反代后端地址；compose 网络内使用服务名 backend:8080，
# 独立运行镜像 / 直连其他主机时改为 host:port，如 192.168.1.100:8080
ANGIE_BACKEND_URL=backend:8080

# Log level: debug / info / warn (default) / error
# 日志级别：debug / info / warn（默认）/ error
# 桌面版默认为 info（日志写入用户数据目录的 manga-reader.log）
# 可在设置页运行时修改。
# LOG_LEVEL=warn

# 开发 / 测试工具（默认关闭，可在设置页运行时开启）
# 启用后可用 /api/dev/* 调试接口，可模拟 ExHentai 不可用，
# 用于验证前端离线回退（书架 / 阅读历史 / 阅读器 / 下载）：
#   curl -X PUT https://<host>/api/dev/upstream-down -H 'Content-Type: application/json' -d '{"down":true}'
# Dev/test tools (default off, toggleable at runtime from the settings page).
# Enables /api/dev/* debug endpoints, including a switch that simulates an
# ExHentai outage to verify offline fallback.
# MANGA_READER_DEV_TOOLS=true

# Image cache storage / 图片缓存存储（可选，启用 /api/image-cache/*）
# 驱动 MANGA_READER_STORAGE_DRIVER：
#   auto（默认）= 配置齐全的 S3/MinIO 时用 s3，否则用 local
#   local       = 本地文件目录（MANGA_READER_STORAGE_DIR）
#   s3          = 强制 S3；配置不全时启动即报错
# 驱动不配置时后端照常启动：没有完整 S3 配置就落到本地文件，不会失败。
# Storage driver: auto (default) picks s3 when the S3 config is complete and
# falls back to plain files otherwise. Set `local` or `s3` to force one.
# MANGA_READER_STORAGE_DRIVER=auto

# Local cache directory when the driver is local (default data/cache)
# 本地缓存目录（driver=local 时生效，默认 data/cache；Docker 内 /app/data/cache）
# MANGA_READER_STORAGE_DIR=data/cache

# S3-compatible object store (MinIO / AWS S3 / R2 ...)
# 任意 S3 兼容对象存储；旧的 MINIO_* 变量仍然有效，且 MANGA_READER_S3_* 优先。
# Legacy MINIO_* names still work; MANGA_READER_S3_* wins when both are set.
MANGA_READER_S3_ENDPOINT=192.168.1.100:9000
MANGA_READER_S3_ACCESS_KEY=minioadmin
MANGA_READER_S3_SECRET_KEY=minioadmin
MANGA_READER_S3_BUCKET=manga-reader-cache
MANGA_READER_S3_USE_SSL=false
MANGA_READER_S3_REGION=
# 寻址方式：auto（默认）/ path（部分 MinIO、R2 需要）/ dns（AWS 默认）
# Bucket addressing: auto (default), path (some MinIO/R2 setups) or dns (AWS).
# MANGA_READER_S3_PATH_STYLE=auto

# Legacy MinIO names — still read when the MANGA_READER_S3_* counterpart is unset.
# 旧变量（仅在对应 MANGA_READER_S3_* 未设置时生效）：
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# MINIO_USE_SSL=false
# MINIO_REGION=

