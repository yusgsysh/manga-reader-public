# ExHentai Cookies (required)
# Method 1: full cookie string
EHENTAI_COOKIE=ipb_member_id=xxx; ipb_pass_hash=xxx
# Method 2: individual env vars
EHENTAI_COOKIE_IPB_MEMBER_ID=
EHENTAI_COOKIE_IPB_PASS_HASH=
EHENTAI_COOKIE_IGNEOUS=
EHENTAI_COOKIE_SK=

# Server port (default: 8080)
EHENTAI_PORT=8080

# SQLite database path (default: data/manga-reader.db; in Docker: /app/data/manga-reader.db)
MANGA_READER_DB_PATH=

# MinIO / S3 Cache (optional, enables /api/cached-image endpoint)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ehviewer-cache
MINIO_USE_SSL=false
MINIO_REGION=
