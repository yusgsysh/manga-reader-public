# Build context for the root Dockerfile (single image: frontend + backend).
# Keep this list tight: every entry here is bytes CI has to ship to the builder
# and, more importantly, data BuildKit has to checksum before it can reuse a
# cached layer.
.git
.github
.forgejo
.playwright-mcp
deploy
.gocache

# Docs, local env template and compose file are not part of the image
**/*.md
docker-compose.yml
Manga Reader API

# Frontend build artifacts — the frontend stage starts clean
frontend/node_modules
frontend/dist
frontend/e2e

# Backend build artifacts — the backend stage builds its own binary
backend/data
backend/manga-reader
backend/*.db
backend/*.db-wal
backend/*.db-shm

# Local frontend bundle drops (stale assets must never be embedded)
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Secrets and local config never enter the image
.env
.env.*
secrets
