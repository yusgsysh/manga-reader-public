# Build context for the root Dockerfile (single image: frontend + backend)
# and for the Android container build. Both contexts must stay small and
# deterministic, and must never contain secrets or stale build output.
.git
.gitignore
.github
.forgejo
deploy

# API design files are not part of any image
Manga Reader API

# Frontend deps / build output (rebuilt inside the image)
frontend/node_modules
frontend/dist
frontend/e2e
frontend/frontend
frontend/package.json.md5
**/node_modules

# Backend build artifacts — the image builds its own binary
backend/data
backend/manga-reader
backend/desktop

# Local frontend bundle drops (stale assets must never be embedded)
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Go task caches and desktop build output
**/.task
backend/cmd/desktop/dist
backend/cmd/desktop/bin
backend/cmd/desktop/build/bin
backend/cmd/desktop/build/frontend

# Generated Android/Gradle output (rebuilt inside the image)
backend/cmd/desktop/build/android/.gradle
backend/cmd/desktop/build/android/build
backend/cmd/desktop/build/android/app/build
backend/cmd/desktop/build/android/app/src/main/jniLibs
backend/cmd/desktop/build/android/gen
backend/cmd/desktop/build/android/overlay.json

# Packaged artifacts
*.apk
*.aab

# Secrets and local config never enter an image
.env
.env.*
!.env.example
secrets
*.htpasswd
