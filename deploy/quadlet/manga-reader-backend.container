# Manga Reader backend (Gin :8080, 仅 pod 内回环可达)
# 安装：/etc/containers/systemd/manga-reader-backend.container
[Container]
Image=git.09270721.xyz/abc/manga-reader-backend:latest
Pod=manga-reader.pod
# 全量配置（EHENTAI_COOKIE、同步令牌、数据库驱动等）
# 注意：键名必须是 EnvironmentFile=（EnvFile= 非法键，quadlet 会跳过整个 unit）
# 该值经 podman --env-file 注入：每行须为 KEY=VALUE，且 $ 不做展开
EnvironmentFile=/root/manga-reader-public/.env
Environment=MANGA_READER_DB_PATH=/app/data/manga-reader.db
# 数据卷：以 podman volume ls 实际名称为准
Volume=manga-reader-public_backend_data:/app/data
AutoUpdate=registry
NoNewPrivileges=true
PodmanArgs=--log-opt max-size=10m --log-opt max-file=3

[Service]
Restart=always
RestartSec=5
