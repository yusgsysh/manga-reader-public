# Manga Reader（单镜像：Gin API + 内嵌前端，容器 :8080 → 宿主 5173）
#
# 安装：manga-reader.pod / manga-reader.container / manga-reader-warp.container
# 三个文件一起放到 /etc/containers/systemd/，然后：
#   systemctl daemon-reload
#   systemctl restart manga-reader.service
# 端口发布在 manga-reader.pod；出站流量经同一 pod 内的 Cloudflare WARP。
#
# 迁移到单镜像：先停用并删除旧 unit，否则旧的 frontend(Angie) 容器会继续跑：
#   systemctl disable --now manga-reader-frontend.service
#   systemctl disable --now manga-reader-backend.service 2>/dev/null || true
#   rm /etc/containers/systemd/manga-reader-{backend,frontend}.container
#   systemctl daemon-reload
[Unit]
# 启动时一并拉起 WARP 客户端（它自己会加入同一个 pod）。
Wants=manga-reader-warp.service
After=manga-reader-warp.service

[Container]
Image=ghcr.io/yusgsysh/manga-reader:latest
# 容器组：共享 WARP 所在的 netns；PublishPort 必须写在 manga-reader.pod 里。
Pod=manga-reader.pod
# 全量配置（EHENTAI_COOKIE、数据库驱动、JWT、Metrics、Node Sync 等）
# 注意：键名必须是 EnvironmentFile=（EnvFile= 非法键，quadlet 会跳过整个 unit）
# 该值经 podman --env-file 注入：每行须为 KEY=VALUE，且 $ 不做展开
# NO_PROXY 仍在 .env 中配置（内网 MinIO / 数据库 / 服务名需要绕过代理）
EnvironmentFile=/root/manga-reader-public/.env
# 出站统一走同一 pod 内的 WARP：WARP 容器的 gost 在共享 netns 的
# 127.0.0.1:1080 上提供 HTTP + SOCKS5 代理，后端请求经它进 Cloudflare 隧道。
# 显式覆盖 .env：pod 内看不到宿主的 127.0.0.1:7890 之类代理地址。
# WARP 掉线时 1080 无监听，请求直接失败，不会静默回退成直连。
Environment=HTTP_PROXY=socks5://127.0.0.1:1080
Environment=HTTPS_PROXY=socks5://127.0.0.1:1080
# 容器内监听所有接口；宿主侧由 manga-reader.pod 的 PublishPort=127.0.0.1 限制。
Environment=EHENTAI_PORT=:8080
Environment=MANGA_READER_DB_PATH=/app/data/manga-reader.db

# JWT 登录认证（推荐；生产置于 HTTPS 之后）。设置 JWT_SECRET 即启用登录页，
# 首次启动还需 ADMIN_PASSWORD 以创建管理员（之后不会覆盖数据库中的哈希）。
# 生成密钥：openssl rand -hex 32
#Environment=JWT_SECRET=<paste output of: openssl rand -hex 32>
#Environment=JWT_ISSUER=manga-reader
#Environment=JWT_EXPIRES_IN=1h
#Environment=ADMIN_USERNAME=admin
#Environment=ADMIN_PASSWORD=change-me-strong-password
#Environment=MANGA_READER_AUTH_COOKIE_SECURE=auto

# Metrics 独立 Token（未设置时 /metrics 仅回环访问）
#Environment=MANGA_READER_METRICS_ENABLED=true
#Environment=MANGA_READER_METRICS_TOKEN=<paste output of: openssl rand -hex 32>

# 节点同步（Node API Key 由平台管理员在 /admin/nodes 创建，存数据库）
#Environment=MANGA_READER_SYNC_ENABLED=true
#Environment=MANGA_READER_SYNC_REQUEST_TIMEOUT=30s
#Environment=MANGA_READER_SYNC_API_KEY_MIN_LENGTH=32

# 数据卷：以 podman volume ls 实际名称为准
Volume=manga-reader-public_backend_data:/app/data
NoNewPrivileges=true
DropCapability=all
PidsLimit=512
HealthCmd=wget -qO- http://127.0.0.1:8080/healthz || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
PodmanArgs=--log-opt max-size=10m --log-opt max-file=3

[Service]
Restart=always
RestartSec=5

[Install]
# quadlet 单元无法 systemctl enable，靠 [Install] 在开机时由 generator 拉起。
WantedBy=multi-user.target
