# Manga Reader frontend (Angie 反代 + 静态站 + HTTP Basic Auth)
# 安装：/etc/containers/systemd/manga-reader-frontend.container
[Container]
Image=git.09270721.xyz/abc/manga-reader-frontend:latest
Pod=manga-reader.pod
# pod 内共享网络：backend 即 127.0.0.1:8080，无 DNS/启动竞态
Environment=ANGIE_BACKEND_URL=127.0.0.1:8080
# HTTP Basic Auth（生产置于 HTTPS 之后；口令含 $ 时在此无需 $$ 转义）
Environment=MANGA_READER_BASIC_AUTH_ENABLED=true
Environment=MANGA_READER_BASIC_AUTH_USERNAME=admin
# 上线前改成真实口令（勿提交真实口令到仓库）
Environment=MANGA_READER_BASIC_AUTH_PASSWORD=change-me-strong-password
# htpasswd 文件模式改用下面两行（并加 --secret）：
#   Environment=MANGA_READER_BASIC_AUTH_FILE=/run/secrets/manga_reader_htpasswd
#   Secret=manga_reader_htpasswd
AutoUpdate=registry
NoNewPrivileges=true
PodmanArgs=--log-opt max-size=10m --log-opt max-file=3

[Service]
Restart=always
RestartSec=5
