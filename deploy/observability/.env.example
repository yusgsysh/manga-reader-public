# 复制为 .env 后按需修改（.env 不提交）

# 抓取目标（宿主机 backend 端口；开发机跑 backend 时改为 127.0.0.1:18080 等）
MANGA_READER_TARGET=host.docker.internal:5173
MANGA_READER_SCHEME=http

# backend 的独立 Metrics Token（与 MANGA_READER_METRICS_TOKEN 一致）
# 生成：openssl rand -hex 32
MANGA_READER_METRICS_TOKEN=

# Grafana 管理员（必填；留空时 compose 拒绝启动，避免默认 admin/admin）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
