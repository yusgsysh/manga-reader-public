backend/manga-reader
backend/data/*
backend/EHentai-go/*

# Wails desktop build artifacts (build/bin is regenerated by `wails build`,
# dist/ holds the frontend copy Wails drops in before compiling)
backend/cmd/desktop/desktop
backend/cmd/desktop/build/bin/
backend/cmd/desktop/dist/*
!backend/cmd/desktop/dist/.gitkeep

# Vite dependency hash
frontend/package.json.md5

# Go task caches
.task/
**/.task/

# Wails v3 generated overlay / staging (root level)
/build/
backend/desktop

# Frontend symlinks/staging created by the containerized build
/frontend/frontend
backend/cmd/desktop/build/frontend
backend/cmd/desktop/frontend/

# Android build outputs and generated sources
backend/cmd/desktop/build/android/.gradle/
backend/cmd/desktop/build/android/build/
backend/cmd/desktop/build/android/app/build/
backend/cmd/desktop/build/android/app/src/main/jniLibs/
backend/cmd/desktop/build/android/gen/
backend/cmd/desktop/build/android/overlay.json

# Packaged Android artifacts
*.apk
*.aab

# HTTP Basic Auth credentials — never commit
*.htpasswd
secrets/

# Frontend bundle embedded into the binary (the image build drops it here;
# only the placeholder is tracked so `go build` works from a fresh clone)
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep
