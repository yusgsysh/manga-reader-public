# Desktop (Wails) build.
# The API origin is injected at runtime as window.__MANGA_READER_CONFIG__
# because Gin binds a random 127.0.0.1 port when the app starts. An empty
# VITE_API_BASE_URL means "same origin", which is what the WebView falls back
# to when the shell serves /api itself.
VITE_API_BASE_URL=
