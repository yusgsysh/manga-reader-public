# Backend API Base URL
# 开发环境：直连后端（后端需允许 CORS）
# 生产环境（同源 /api/*）：留空，前端走同源 /api/*
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Kinde OIDC（公开配置，禁止放 Client Secret）
# 这些值会在构建时烘焙进前端产物；CI 从仓库 Variables 读取。
# 本地开发使用下面的 localhost；生产请替换为实际前端地址。
# ---------------------------------------------------------------------------
# Kinde 租户域名（不带末尾斜杠）
VITE_KINDE_DOMAIN=https://<tenant>.kinde.com
# Kinde Application 的 Client ID（Front-end and mobile 类型）
VITE_KINDE_CLIENT_ID=
# 登录成功后的回调地址。必须与 Kinde Dashboard 的 Allowed callback URLs 完全一致。
# 根路径不要带末尾斜杠（SDK 的授权 URL 会去掉斜杠，token 交换使用原值）。
# 例如 http://localhost:5173 或 http://localhost:5173/login
VITE_KINDE_REDIRECT_URI=http://localhost:5173
# 退出登录后的回跳地址。必须与 Allowed logout redirect URLs 一致。
VITE_KINDE_LOGOUT_URI=http://localhost:5173/login
# API Audience（与后端 KINDE_API_AUDIENCE 完全一致）
VITE_KINDE_AUDIENCE=https://api.manga.example.com

# EhTagTranslation 翻译数据库 (JSONP .js)
# 运行时通过 <script> 加载，用于 Tag 中文翻译展示。
# 默认加载项目内置的 public/db.text.js（同源，快）；
# 右上角更新按钮会从下方 REMOTE URL 拉取最新版并存入 IndexedDB。
# 可覆盖为自托管地址（如内网镜像）。
# VITE_TAG_TRANSLATION_DB_URL=/db.text.js
# VITE_TAG_TRANSLATION_REMOTE_URL=https://github.com/EhTagTranslation/Database/releases/latest/download/db.text.js
