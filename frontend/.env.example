# Backend API Base URL
# 前端通过该地址直连 Backend 的 REST API（后端需允许 CORS）。
# 未设置时默认使用 http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# EhTagTranslation 翻译数据库 (JSONP .js)
# 运行时通过 <script> 加载，用于 Tag 中文翻译展示。
# 默认使用官方 GitHub Release 的纯文本版 db.text.js (免 HTML 解析)；
# 可覆盖为自托管地址（如内网镜像）。
# VITE_TAG_TRANSLATION_DB_URL=https://github.com/EhTagTranslation/Database/releases/latest/download/db.text.js
