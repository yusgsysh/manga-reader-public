{
  "name": "manga-frontend-init",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "vite build --mode e2e",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "bun run build:e2e && bun e2e/reader-pages.mjs && bun run test:e2e:reader-loading",
    "test:e2e:reader-loading": "EXPECT_FIXED=1 bun e2e/repro-reader-loading.mjs",
    "repro:reader-loading": "bun run build:e2e && bun e2e/repro-reader-loading.mjs",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview",
    "db:update": "node scripts/update-tag-db.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.17.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "@yui540/comimi": "^0.26.0",
    "@yui540/comimi-react": "^0.3.0",
    "motion": "^13.5.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "@yui540/comimi@0.26.0": "patches/@yui540%2Fcomimi@0.26.0.patch",
    "@yui540/comimi-react@0.3.0": "patches/@yui540%2Fcomimi-react@0.3.0.patch"
  }
}
